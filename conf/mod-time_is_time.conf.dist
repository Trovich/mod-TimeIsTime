#####################################################################################################
[worldserver]

# Announce
#####################################################################################################
# Announce  TimeIsTime
# Settings: 0 = off, 1 = on
# Default:  1 
# Example:  TimeIsTime.Announce = 1 
#####################################################################################################
TimeIsTime.Announce = 1

# Enable
#####################################################################################################
# Enable TimeIsTime
# Settings: 0 = off, 1 = on
# Default:  1
# Example:  TimeIsTime.Enable = 1 
#####################################################################################################
TimeIsTime.Enable = 1

# SpeedRate
#####################################################################################################
# Adjust the number of game days per real day by altering the Realm Timer
# Settings: 60 is 1 second (Real Time) = 1 minute (Realm Timer)
#           
#           60.0  = 1 Game Day every 24   minutes
#           30.0  = 1 Game Day every 48   minutes         
#           15.0  = 1 Game Day every 96   minutes or 1.6  Hours
#           7.5   = 1 Game Day every 192  minutes or 3.2  Hours
#           3.75  = 1 Game Day every 384  minutes or 6.4  Hours        
#           1.875 = 1 Game Day every 768  minutes or 12.8 Hours
#           1.0   = 1 Game Day every 1440 minutes or 24.0 Hours 
# Default:  1.0 (Blizzlike)
# Example:  TimeIsTime.SpeedRate = 1.0
#####################################################################################################
TimeIsTime.SpeedRate = 1.0

# TimeStart and HourOffset:
#####################################################################################################
# Start (client side) game clock at chosen Epoch (Unix) time at the same time each login
# Default:  0  (Local Time)
# Example:  Based on the settings below, the GMT TimeStart and HourOffset would be:
#           TimeIsTime.TimeStart = 205364700
#           TimeIsTime.HourOffset = 5
#           City: Chicago, IL USA
#           Summer Solstice Date   :: 06-20-2008
#           Sunrise  = 05:15:27    :: 1213938927
#           Sunset   = 20:29:01    :: 1213993741
#           Midday   = 12:00:00    :: 1213963200
#           Midnight = 24:00:00    :: 1213920000
#####################################################################################################
TimeIsTime.TimeStart = 0
TimeIsTime.HourOffset = 0.0

# Outland.FixedHour
#####################################################################################################
# Outland has no day and night: while a player is in Outland his client clock stands at this hour
# (sky, light, sun and shadows stop with it; the minimap clock in "realm time" stands as well).
# Eversong Woods, Ghostlands, Silvermoon, Quel'Danas, Azuremyst, Bloodmyst and the Exodar are stored
# on the Outland map but keep the ordinary day.
# Settings: 0.0 - 23.99 = hour of the day (12.0 = noon, 18.5 = 18:30)
#           -1          = off, Outland follows the world clock
# Default:  12.0
# Example:  TimeIsTime.Outland.FixedHour = 12.0
#####################################################################################################
TimeIsTime.Outland.FixedHour = 12.0

# FixedHour.MapIds / FixedHour.Hour
#####################################################################################################
# Whole maps where the client clock stands at one hour, as in Outland: an endless day (or night).
# Map 37 is the test range on Azshara Crater (docs/test-range.md).
# Settings: MapIds = map ids separated by commas, empty = none
#           Hour   = 0.0 - 23.99 (12.0 = noon), -1 = off
# Default:  MapIds = ""   Hour = 12.0
#####################################################################################################
TimeIsTime.FixedHour.MapIds = ""
TimeIsTime.FixedHour.Hour = 12.0
